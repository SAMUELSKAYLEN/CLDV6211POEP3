@model IEnumerable<ST10443307CLVDProjectPOEPart3.Models.Event>

@{
    ViewData["Title"] = "Event information";
}

<h1>Event list</h1>

<!--insert filter form-->
<form method="get" class="mb-4">
    <div class="row">
        <label>Event Type</label>
        <select name="searchType" class="form-control">
            <option value="">--All types--</option>
            @foreach (var type in(List<EventType>)ViewData["EventType"])
            {
                <option value="@type.EventTypeName">@type.EventTypeName</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label>Venue</label>
        <select name="VENUEID" class="form-control">
            <option value="">--All venues--</option>
            @foreach (var venue in (List<Venue>)ViewData["Venues"])
            {
                <option value="@venue.VENUEID">@venue.VenueName</option>
            }
        </select>
    </div>
    <!--Start date filter-->
    <div class="col-md-3">
        <label>Start date</label>
        <input type="date" name="startDate" class="form-control"/>
    </div>
    <!--End date filter-->
    <div class="col-md-3">
        <label>End date</label>
        <input type="date" name="endDate" class="form-control" />
    </div>
    <!--Filter button-->
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/Event/Index" class="btn btn-secondary ml-2">Clear</a>
    </div>
    
</form>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type ="button" class=" btn-close" data-bs-dismiss = "alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class=" btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

    </div>
}

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EventName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descript)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VENUEID)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.EventName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EventDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descript)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VENUEID)
            </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EVENTID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.EVENTID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.EVENTID">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
